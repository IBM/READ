# Copy this file to .env and fill in the keys you need.
# .env is gitignored; never commit real keys.

# Public providers (recommended for external users)
# Required for `--models gpt-4o`
OPENAI_API_KEY=

# Required for `--models claude-sonnet-4-5`
ANTHROPIC_API_KEY=

# IBM-internal Research Inference Service (RITS)
# Required for the 13 RITS-hosted models (granite-guardian, llama-guard,
# llama-3-*, gpt-oss-*, mistral, qwen, phi-4, etc.).
# Leave both empty if you only use OpenAI / Anthropic models.
READ_RITS_BASE=
RITS_API_KEY=
